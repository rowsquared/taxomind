# Taxomind API Configuration

# API Authentication Tokens
# You can specify multiple tokens separated by commas
# Generate tokens using: python scripts/generate_token.py
API_TOKENS=your-secret-token-here,another-token-here

# Or use a single token
# API_TOKEN=your-single-secret-token

# Enable/Disable API Authentication
# Set to "false" to disable authentication (not recommended for production)
API_AUTH_ENABLED=true

# Example tokens (DO NOT USE IN PRODUCTION):
# API_TOKENS=dev-token-12345,test-token-67890
